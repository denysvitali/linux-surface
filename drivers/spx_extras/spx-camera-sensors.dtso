// SPDX-License-Identifier: GPL-2.0
/*
 * Surface Pro X (sc8180x) camera: CCI buses + sensor nodes.
 * STAGED — NOT APPLIED. Companion to spx-camss.dtso.
 *
 * Everything below is reverse-engineered from the SPX DSDT and the Windows
 * camera drivers (2026-08-04); see memory/spx-camera-bringup.md.
 *
 * CCI addressing: ACPI CAMP._CRS lists 0x0ac4a000/b000/c000/d000 (0x1000 each)
 * plus 4 interrupts GSIV 0x1ec/0x12f/0x2ab/0x2aa -> SPI 460/271/651/650.
 * That block layout is identical to sc8280xp.dtsi, and cci0's SPI 460 matches
 * sm8250 exactly. camcc-sc8180x provides CAM_CC_CCI_0..3_CLK.
 *
 * Sensor placement comes from the ACPI CAMP.PCFG method, which returns
 * {0x07, 0x00200000, 0x00010010, 0x01300011, 0,...}: element 0 is a presence
 * bitmask (all three present), elements 1..3 are one packed word per camera ID
 * (rear=0, front=1, aux=2). qccamplatform8180.sys decodes
 *   CCI master = (w >> 16) & 0xf      CSIPHY id = (w >> 20) & 0xf
 * and hands the result to each sensor driver over IOCTL 0x232083, where they
 * surface as the logged "I2cMasterIndex" and "PhyId"/"CamIfPort".
 *
 *   rear  OV13858 @0x10  CCI0 port0  CSIPHY2
 *   front OV5693  @0x36  CCI1 port0  CSIPHY0
 *   aux   OV7251  @0x60  CCI0 port1  CSIPHY3
 *
 * I2C addresses and chip IDs cross-check against ACPI CAMS/CAMF/CAMI SCFG and
 * against the Chromatix sensor-module blobs. Bus speed is 400 kHz, from
 * SCFG acpiMethodValues[0] bits[17:16] == 1.
 *
 * !!! OPEN — the one thing the RE could not recover !!!
 * The sensor supply rails and reset/standby lines are NOT visible to the OS.
 * CAMP._CRS carries the only two camera GPIOs in the whole DSDT (TLMM 11 and
 * 25) and those are the privacy/IR LEDs, not sensor power. The Chromatix blobs
 * give the *shape* of the sequence but only abstract types:
 *
 *   rear  : RESET=0 d1, REG1 d1, REG2 d1, REG3 d1, MCLK 24MHz d10, RESET=1 d30
 *           (power-down also drops a REG4 = the AF/VCM rail)
 *   front : REG3, REG1, REG2, MCLK 24MHz d1, STANDBY=0, RESET=0, STANDBY=1, RESET=1
 *   aux   : RESET=0 d1, REG1 d1, REG2 d1, REG3 d0, MCLK 24MHz d1, RESET=1 d18
 *
 * Windows executes these through the PEP/firmware power engine (CAMP._PS0/_PS3
 * -> \_SB.PEP0.FLD0), so no APPS-side rail or pin mapping exists to extract.
 * The *-supply and reset-gpios properties below are therefore deliberately
 * absent: they need a schematic, a board teardown, or PMIC probing. Sensor
 * probe WILL fail until they are filled in.
 *
 * Also NOT reverse-engineered, and assumed here — fix before trusting:
 *  - the MCLK index per sensor (MCLK0/1/3 below is a guess; only the 24 MHz
 *    rate is RE-derived). The Windows blob does not name an MCLK instance.
 *  - data-lanes. laneAssign/isComboMode decode to 0 in all three blobs, so the
 *    lane counts below are datasheet-typical values (OV13858 4, OV5693 2,
 *    OV7251 1), not measurements.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/qcom,sc8180x-camcc.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

&{/soc@0} {
	cci0: cci@ac4a000 {
		compatible = "qcom,sc8180x-cci", "qcom,msm8996-cci";
		#address-cells = <1>;
		#size-cells = <0>;

		reg = <0 0x0ac4a000 0 0x1000>;
		interrupts = <GIC_SPI 460 IRQ_TYPE_EDGE_RISING>;
		power-domains = <&camcc TITAN_TOP_GDSC>;

		clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
			 <&camcc CAM_CC_SLOW_AHB_CLK_SRC>,
			 <&camcc CAM_CC_CPAS_AHB_CLK>,
			 <&camcc CAM_CC_CCI_0_CLK>,
			 <&camcc CAM_CC_CCI_0_CLK_SRC>;
		clock-names = "camnoc_axi", "slow_ahb_src", "cpas_ahb",
			      "cci", "cci_src";
		status = "okay";

		/* rear camera */
		cci0_i2c0: i2c-bus@0 {
			reg = <0>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			ov13858: camera@10 {
				compatible = "ovti,ov13858";
				reg = <0x10>;
				clocks = <&camcc CAM_CC_MCLK0_CLK>;
				assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
				assigned-clock-rates = <24000000>;
				/* TODO: *-supply, reset-gpios (see header) */

				port {
					ov13858_ep: endpoint {
						data-lanes = <1 2 3 4>;
						remote-endpoint = <&csiphy2_ep>;
					};
				};
			};
		};

		/* IR / Windows Hello camera */
		cci0_i2c1: i2c-bus@1 {
			reg = <1>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			ov7251: camera@60 {
				compatible = "ovti,ov7251";
				reg = <0x60>;
				clocks = <&camcc CAM_CC_MCLK3_CLK>;
				assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
				assigned-clock-rates = <24000000>;
				/* TODO: *-supply, enable-gpios (see header) */

				port {
					ov7251_ep: endpoint {
						data-lanes = <1>;
						remote-endpoint = <&csiphy3_ep>;
					};
				};
			};
		};
	};

	cci1: cci@ac4b000 {
		compatible = "qcom,sc8180x-cci", "qcom,msm8996-cci";
		#address-cells = <1>;
		#size-cells = <0>;

		reg = <0 0x0ac4b000 0 0x1000>;
		interrupts = <GIC_SPI 271 IRQ_TYPE_EDGE_RISING>;
		power-domains = <&camcc TITAN_TOP_GDSC>;

		clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
			 <&camcc CAM_CC_SLOW_AHB_CLK_SRC>,
			 <&camcc CAM_CC_CPAS_AHB_CLK>,
			 <&camcc CAM_CC_CCI_1_CLK>,
			 <&camcc CAM_CC_CCI_1_CLK_SRC>;
		clock-names = "camnoc_axi", "slow_ahb_src", "cpas_ahb",
			      "cci", "cci_src";
		status = "okay";

		/* front camera */
		cci1_i2c0: i2c-bus@0 {
			reg = <0>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			ov5693: camera@36 {
				compatible = "ovti,ov5693";
				reg = <0x36>;
				clocks = <&camcc CAM_CC_MCLK1_CLK>;
				assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
				assigned-clock-rates = <24000000>;
				/* TODO: *-supply, reset-gpios (see header) */

				port {
					ov5693_ep: endpoint {
						data-lanes = <1 2>;
						remote-endpoint = <&csiphy0_ep>;
					};
				};
			};
		};
	};
};
