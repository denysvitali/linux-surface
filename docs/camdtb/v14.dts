	firmware {

		scm {
			compatible = "qcom,scm-sc8180x", "qcom,scm";
		};
	};

	interconnect-camnoc-virt {
		compatible = "qcom,sc8180x-camnoc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x21>;
	};

	interconnect-mc-virt {
		compatible = "qcom,sc8180x-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x21>;
		phandle = <0x06>;
	};

	interconnect-qup-virt {
		compatible = "qcom,sc8180x-qup-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x21>;
		phandle = <0x2f>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	mmcx-reg {
		compatible = "regulator-fixed-domain";
		power-domains = <0x22 0x06>;
		required-opps = <0x23>;
		regulator-name = "MMCX";
		phandle = <0x79>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x05 0x04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x24>;
			domain-idle-states = <0x25>;
			phandle = <0x08>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x24>;
			domain-idle-states = <0x25>;
			phandle = <0x0b>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x24>;
			domain-idle-states = <0x25>;
			phandle = <0x0d>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x24>;
			domain-idle-states = <0x25>;
			phandle = <0x0f>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x24>;
			domain-idle-states = <0x26>;
			phandle = <0x12>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x24>;
			domain-idle-states = <0x26>;
			phandle = <0x14>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x24>;
			domain-idle-states = <0x26>;
			phandle = <0x16>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x24>;
			domain-idle-states = <0x26>;
			phandle = <0x18>;
		};

		power-domain-cpu-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x27 0x28>;
			phandle = <0x24>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		hyp@85700000 {
			reg = <0x00 0x85700000 0x00 0x600000>;
			no-map;
		};

		xbl@85d00000 {
			reg = <0x00 0x85d00000 0x00 0x140000>;
			no-map;
		};

		aop@85f00000 {
			reg = <0x00 0x85f00000 0x00 0x20000>;
			no-map;
		};

		cmd-db@85f20000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x85f20000 0x00 0x20000>;
			no-map;
		};

		reserved@85f40000 {
			reg = <0x00 0x85f40000 0x00 0x10000>;
			no-map;
		};

		smem@86000000 {
			compatible = "qcom,smem";
			reg = <0x00 0x86000000 0x00 0x200000>;
			no-map;
			hwlocks = <0x29 0x03>;
		};

		reserved@86200000 {
			reg = <0x00 0x86200000 0x00 0x3900000>;
			no-map;
		};

		reserved@89b00000 {
			reg = <0x00 0x89b00000 0x00 0x1c00000>;
			no-map;
		};

		reserved@9d400000 {
			reg = <0x00 0x9d400000 0x00 0x1000000>;
			no-map;
		};

		reserved@9e400000 {
			reg = <0x00 0x9e400000 0x00 0x1400000>;
			no-map;
		};

		reserved@9f800000 {
			reg = <0x00 0x9f800000 0x00 0x800000>;
			no-map;
		};

		memory@85500000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0x85500000 0x00 0x200000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f>;
		};

		memory@8bc00000 {
			reg = <0x00 0x8bc00000 0x00 0x180000>;
			no-map;
			phandle = <0x9c>;
		};

		memory@8d800000 {
			reg = <0x00 0x8d800000 0x00 0x9600000>;
			no-map;
			phandle = <0x59>;
		};

		memory@96e00000 {
			reg = <0x00 0x96e00000 0x00 0x1a00000>;
			no-map;
			phandle = <0x92>;
		};

		memory@98800000 {
			reg = <0x00 0x98800000 0x00 0x800000>;
			no-map;
			phandle = <0x5c>;
		};

		memory@99000000 {
			reg = <0x00 0x99000000 0x00 0x1400000>;
			no-map;
		};

		memory@9a400000 {
			reg = <0x00 0x9a400000 0x00 0x5000>;
			no-map;
			phandle = <0x52>;
		};

		memory@9a480000 {
			reg = <0x00 0x9a480000 0x00 0x100000>;
			no-map;
			phandle = <0xae>;
		};
