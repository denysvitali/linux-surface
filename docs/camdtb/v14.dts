/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Microsoft Surface Pro X (SQ2)";
	compatible = "microsoft,surface-pro-x", "qcom,sc8180x";

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x249f000>;
			phandle = <0x93>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			clock-output-names = "sleep_clk";
			phandle = <0x2c>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo485";
			reg = <0x00 0x00>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x25a>;
			next-level-cache = <0x02>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x04>;
			interconnects = <0x05 0x00 0x03 0x06 0x01 0x03 0x07 0x00 0x07 0x01>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			clocks = <0x03 0x00>;
			phandle = <0x19>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x02>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x09>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo485";
			reg = <0x00 0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x25a>;
			next-level-cache = <0x0a>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x04>;
			interconnects = <0x05 0x00 0x03 0x06 0x01 0x03 0x07 0x00 0x07 0x01>;
			power-domains = <0x0b>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			clocks = <0x03 0x00>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0a>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo485";
			reg = <0x00 0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x25a>;
			next-level-cache = <0x0c>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x04>;
			interconnects = <0x05 0x00 0x03 0x06 0x01 0x03 0x07 0x00 0x07 0x01>;
			power-domains = <0x0d>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			clocks = <0x03 0x00>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0c>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo485";
			reg = <0x00 0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x25a>;
			next-level-cache = <0x0e>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x04>;
			interconnects = <0x05 0x00 0x03 0x06 0x01 0x03 0x07 0x00 0x07 0x01>;
			power-domains = <0x0f>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			clocks = <0x03 0x00>;
			phandle = <0x1c>;

			l2-cache {
				compatible = "cache";
				cache-unified;
				cache-level = <0x02>;
				next-level-cache = <0x09>;
				phandle = <0x0e>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo485";
			reg = <0x00 0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			next-level-cache = <0x10>;
			qcom,freq-domain = <0x03 0x01>;
			operating-points-v2 = <0x11>;
			interconnects = <0x05 0x00 0x03 0x06 0x01 0x03 0x07 0x00 0x07 0x01>;
			power-domains = <0x12>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			clocks = <0x03 0x01>;
			phandle = <0x1d>;

			l2-cache {
				compatible = "cache";
				cache-unified;
				cache-level = <0x02>;
				next-level-cache = <0x09>;
				phandle = <0x10>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo485";
			reg = <0x00 0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			next-level-cache = <0x13>;
			qcom,freq-domain = <0x03 0x01>;
			operating-points-v2 = <0x11>;
			interconnects = <0x05 0x00 0x03 0x06 0x01 0x03 0x07 0x00 0x07 0x01>;
			power-domains = <0x14>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			clocks = <0x03 0x01>;
			phandle = <0x1e>;

			l2-cache {
				compatible = "cache";
				cache-unified;
				cache-level = <0x02>;
				next-level-cache = <0x09>;
				phandle = <0x13>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo485";
			reg = <0x00 0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			next-level-cache = <0x15>;
			qcom,freq-domain = <0x03 0x01>;
			operating-points-v2 = <0x11>;
			interconnects = <0x05 0x00 0x03 0x06 0x01 0x03 0x07 0x00 0x07 0x01>;
			power-domains = <0x16>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			clocks = <0x03 0x01>;
			phandle = <0x1f>;

			l2-cache {
				compatible = "cache";
				cache-unified;
				cache-level = <0x02>;
				next-level-cache = <0x09>;
				phandle = <0x15>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo485";
			reg = <0x00 0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			next-level-cache = <0x17>;
			qcom,freq-domain = <0x03 0x01>;
			operating-points-v2 = <0x11>;
			interconnects = <0x05 0x00 0x03 0x06 0x01 0x03 0x07 0x00 0x07 0x01>;
			power-domains = <0x18>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			clocks = <0x03 0x01>;
			phandle = <0x20>;

			l2-cache {
				compatible = "cache";
				cache-unified;
				cache-level = <0x02>;
				next-level-cache = <0x09>;
				phandle = <0x17>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x19>;
				};

				core1 {
					cpu = <0x1a>;
				};

				core2 {
					cpu = <0x1b>;
				};

				core3 {
					cpu = <0x1c>;
				};

				core4 {
					cpu = <0x1d>;
				};

				core5 {
					cpu = <0x1e>;
				};

				core6 {
					cpu = <0x1f>;
				};

				core7 {
					cpu = <0x20>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x163>;
				exit-latency-us = <0x38d>;
				min-residency-us = <0xf5e>;
				local-timer-stop;
				phandle = <0x25>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x96b>;
				exit-latency-us = <0x5b5>;
				min-residency-us = <0x1188>;
				local-timer-stop;
				phandle = <0x26>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0xce4>;
				exit-latency-us = <0xce4>;
				min-residency-us = <0x1770>;
				phandle = <0x27>;
			};

			cluster-sleep-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x4100a344>;
				entry-latency-us = <0xcbf>;
				exit-latency-us = <0x19a2>;
				min-residency-us = <0x2703>;
				phandle = <0x28>;
			};
		};
	};

	opp-table-cpu0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x04>;

		opp-300000000 {
			opp-hz = <0x00 0x11e1a300>;
			opp-peak-kBps = <0xc3500 0x927c00>;
		};

		opp-422400000 {
			opp-hz = <0x00 0x192d5000>;
			opp-peak-kBps = <0xc3500 0x927c00>;
