	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x01 0x08 0x01 0x02 0x08 0x01 0x03 0x08 0x01 0x00 0x08>;
	};

	aliases {
		serial0 = "/soc@0/geniqup@cc0000/serial@c8c000";
		serial1 = "/soc@0/geniqup@cc0000/serial@c94000";
	};

	backlight {
		compatible = "pwm-backlight";
		pwms = <0xa7 0x04 0x4c4b40>;
		enable-gpios = <0xa8 0x01 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xa9 0xaa>;
		phandle = <0x87>;
	};

	gpio-keys-volume {
		compatible = "gpio-keys";
		label = "Volume Buttons";
		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <0xab 0xac>;

		volume-down {
			label = "Volume Down";
			gpios = <0xad 0x01 0x01>;
			linux,code = <0x72>;
		};

		volume-up {
			label = "Volume Up";
			gpios = <0xad 0x06 0x01>;
			linux,code = <0x73>;
		};
	};

	chosen {
		linux,pstore = <0xae>;
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		phandle = <0x95>;
	};

	pm8150-s4 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_s4a_1p8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <0x95>;
		phandle = <0x3f>;
	};

	ts-5p0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vreg_ts_5p0";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0xa8 0x0a 0x00>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <0xaf>;
		phandle = <0x38>;
	};

	sound {
		compatible = "qcom,sdm845-sndcard";
		model = "Surface Pro X";
		audio-routing = "RX_BIAS", "MCLK", "Int Mic", "DMIC0", "AMIC1", "MIC BIAS1", "AMIC2", "MIC BIAS2", "AMIC3", "MIC BIAS3", "AMIC4", "MIC BIAS4", "DMIC0", "MIC BIAS1", "DMIC1", "MIC BIAS1", "DMIC2", "MIC BIAS3", "DMIC3", "MIC BIAS3", "Headphone Jack", "HPHL", "Headphone Jack", "HPHR", "Headset Mic", "AMIC2", "Left Spk", "SpkrLeft SPKR", "SpkrLeft IN", "SPK1 OUT", "Right Spk", "SpkrRight SPKR", "SpkrRight IN", "SPK2 OUT";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <0xb0 0x00>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <0xb0 0x01>;
			};
		};

		mm3-dai-link {
			link-name = "MultiMedia3";

			cpu {
				sound-dai = <0xb0 0x02>;
			};
		};

		slim-playback-dai-link {
			no_pcm = <0x01>;
			link-name = "SLIM Playback";

			cpu {
				sound-dai = <0xb1 0x06>;
			};

			platform {
				sound-dai = <0xb2>;
			};

			codec {
				sound-dai = <0x3c 0x00 0xb3 0xb4 0xb5 0x00>;
			};
		};

		slim-capture-dai-link {
			link-name = "SLIM Capture";

			cpu {
				sound-dai = <0xb1 0x03>;
			};

			platform {
				sound-dai = <0xb2>;
			};

			codec {
				sound-dai = <0x3c 0x01>;
			};
		};
	};

	spx-cam-avdd {
		compatible = "regulator-fixed";
		regulator-name = "spx-cam-avdd-2v85";
		regulator-min-microvolt = <0x2b7460>;
		regulator-max-microvolt = <0x2b7460>;
		regulator-always-on;
		phandle = <0xc0>;
	};

	spx-cam-dovdd {
		compatible = "regulator-fixed";
		regulator-name = "spx-cam-dovdd-1v8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		phandle = <0xc1>;
	};

	spx-cam-dvdd {
		compatible = "regulator-fixed";
		regulator-name = "spx-cam-dvdd-1v2";
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x124f80>;
		regulator-always-on;
		phandle = <0xc2>;
	};
};
