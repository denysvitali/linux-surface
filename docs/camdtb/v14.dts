					pins = "gpio27";
					function = "qup15";
					bias-pull-down;
				};

				rts-tx {
					pins = "gpio28", "gpio29";
					function = "qup15";
					drive-strength = <0x02>;
					bias-disable;
				};

				rx {
					pins = "gpio30";
					function = "qup15";
					bias-pull-up;
				};
			};

			ssam-state {
				phandle = <0x44>;

				wake-int {
					pins = "gpio180";
					function = "gpio";
					bias-disable;
				};
			};

			panel-vdd-en-default-state {
				pins = "gpio130";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				output-high;
				phandle = <0x86>;
			};

			epd-hpd-active-state {
				pins = "gpio10";
				function = "edp_hot";
				phandle = <0x83>;
