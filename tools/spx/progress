#!/usr/bin/env python3
"""Report historical acceptance and current-boot automatic hardware results."""
import json
import pathlib
import re
import sys

root = pathlib.Path(__file__).resolve().parents[2]
text = (root / "PORT-CHECKLIST.md").read_text()
boxes = re.findall(r"^- \[([ x])\] \*\*([A-Z]\d\d) — ", text, re.M)
closed = [box for mark, box in boxes if mark == "x"]
print(f"boxes closed: {len(closed)} of {len(boxes)}; historical full acceptance")
print("closed:", " ".join(closed) or "none")

checklist = root / "AUTO-HW-CHECKLIST.md"
problems = []
if len(boxes) != 47:
    problems.append(f"historical checklist expected 47 boxes, found {len(boxes)}")
if not checklist.exists():
    problems.append("automatic checklist missing; run tools/spx/hw-validation")
else:
    current = checklist.read_text()
    link = re.search(r"^Report JSON: \[.*?\]\((.*?)\)$", current, re.M)
    if link is None:
        problems.append("no automatic report link; generate from a real boot result")
    else:
        path = pathlib.Path(link.group(1))
        if not path.is_absolute():
            path = root / path
        try:
            report = json.loads(path.read_text())
            meta, counts = report["meta"], report["counts"]
            boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
            valid = not meta["fixture"] and meta["mode"] == "run" and meta["boot_id"] == boot
            if not valid:
                problems.append("automatic results are fixture/catalog/another boot; rerun on this boot")
            print(f"automatic functional checks passed: {counts['functional_passed']} of {counts['functional']}")
            print(f"inventory observed: {counts['inventory_observed']} of {counts['inventory']}; "
                  f"blocked: {counts['blocked']}; failed: {counts['failed']}; errors: {counts['errors']}")
            print(f"boot: {meta['boot_id']}; kernel: {meta['kernel']}; report: {path}")
            if "-v" in sys.argv[1:]:
                for check, result in zip(report["catalog"], report["results"]):
                    if result["status"] in ("blocked", "fail", "error"):
                        print(f"{result['status']}: {check['id']}: {result['detail']}")
            if counts["failed"] or counts["errors"] or report.get("errors"):
                problems.append("automatic validation recorded failures/errors; inspect the report")
        except PermissionError:
            # Boot logs stay private. The generated checklist contains only summaries.
            identity = re.search(r"^Boot: `([^`]+)`.*?^Kernel: `([^`]+)`", current, re.M | re.S)
            summary = re.search(r"Functional checks passed: \*\*(\d+) of (\d+)\*\*\. "
                                r"Inventory observations: (\d+) of (\d+)\. Blocked: (\d+)\. "
                                r"Failed: (\d+)\. Errors: (\d+)\.", current)
            boot = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
            kernel = pathlib.Path("/proc/sys/kernel/osrelease").read_text().strip()
            if (identity is None or summary is None or identity.group(1) != boot or
                    identity.group(2) != kernel or "Mode: run; fixture: false" not in current):
                problems.append("generated automatic checklist unavailable/stale; rerun validation")
            else:
                passed, total, observed, inventories, blocked, failed, errors = summary.groups()
                print(f"automatic functional checks passed: {passed} of {total}")
                print(f"inventory observed: {observed} of {inventories}; blocked: {blocked}; failed: {failed}; errors: {errors}")
                print(f"boot: {identity.group(1)}; kernel: {identity.group(2)}; private report: {path}")
                if "-v" in sys.argv[1:]:
                    for line in current.splitlines():
                        if any(status in line for status in ("; blocked)", "; fail)", "; error)")):
                            print(line)
                if int(failed) or int(errors) or "Report error:" in current:
                    problems.append("automatic validation recorded failures/errors; inspect the report")
        except (OSError, ValueError, KeyError, TypeError) as error:
            problems.append(f"automatic report unavailable/invalid: {error}")
for problem in problems:
    print("VALIDATION:", problem, file=sys.stderr)
sys.exit(1 if problems else 0)
