[Unit]
Description=Work around the Surface Pro X SSAM firmware startup timeout once
After=systemd-journald.service systemd-udev-trigger.service
ConditionPathExists=/sys/firmware/devicetree/base/compatible

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/spx-boot-diagnostics/ssam_startup.py
RemainAfterExit=yes
TimeoutStartSec=75
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
