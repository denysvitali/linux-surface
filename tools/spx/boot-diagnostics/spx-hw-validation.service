[Unit]
Description=Surface Pro X safe automatic validation on every boot
Wants=network-online.target
After=local-fs.target network-online.target bluetooth.service display-manager.service spx-boot-evidence.service spx-desktop-playback.service spx-sensors.service
RequiresMountsFor=/var/lib/spx-boot-diagnostics
StartLimitIntervalSec=0

[Service]
Type=exec
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /usr/local/lib/spx-boot-diagnostics/automatic-validation.py run
ExecStopPost=/usr/bin/python3 -B /usr/local/lib/spx-boot-diagnostics/automatic-validation.py finalize
UMask=0077
Nice=10
Restart=no
RestartForceExitStatus=75
RestartSec=60

[Install]
WantedBy=multi-user.target
