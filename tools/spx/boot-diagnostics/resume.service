[Unit]
Description=Resume the authorized SPX port session after an armed boot
Wants=happy-daemon.service
After=happy-daemon.service
# resume.py permits known-good recovery or an explicitly matching trial only.
ConditionPathExists=%h/.local/state/spx-port/resume-armed.json
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:%h/go/bin:/usr/local/bin:/usr/bin"
WorkingDirectory=%h/Documents/git/linux-surface-next
ExecStart=/usr/bin/python3 %h/.local/state/spx-port/resume.py
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
