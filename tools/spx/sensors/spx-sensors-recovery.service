[Unit]
Description=Guarded once-per-boot Surface SensorsPD host failure recovery
ConditionKernelCommandLine=spx_sensors_recovery=1
After=spx-sensors.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /usr/local/libexec/spx-sensors/recovery.py
TimeoutStartSec=200
TimeoutStopSec=10
Restart=no
User=root
Group=root
ProtectHome=yes
ProtectKernelModules=yes
NoNewPrivileges=yes
