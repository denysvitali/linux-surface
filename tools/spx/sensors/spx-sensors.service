[Unit]
Description=Surface Pro X initial SensorsPD listener and SSC readiness
ConditionKernelCommandLine=spx_sensors=1
After=local-fs.target systemd-modules-load.service
Before=iio-sensor-proxy.service
RequiresMountsFor=/usr/share/qcom/sc8180x/Microsoft/spx /usr/local/libexec/spx-sensors

OnFailure=spx-sensors-recovery.service

[Service]
RuntimeDirectory=spx-sensors
RuntimeDirectoryPreserve=yes
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -B /usr/local/libexec/spx-sensors/supervise.py
Restart=no
TimeoutStartSec=95
TimeoutStopSec=10
User=root
Group=root
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_QIPCRTR
DevicePolicy=closed
DeviceAllow=/dev/fastrpc-sdsp-secure rw

[Install]
WantedBy=multi-user.target
