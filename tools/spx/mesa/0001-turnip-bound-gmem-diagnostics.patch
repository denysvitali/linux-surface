+                      att->load, att->store, att->store_stencil, att->gmem,
+                      iview->image->vk.tiling, iview->image->vk.drm_format_mod,
+                      iview->image->layout[0].tile_mode, iview->view.ubwc_enabled,
+                      iview->view.is_mutable);
+         }
+      } else if (record == 256) {
+         mesa_logi("gmem-witness select limit reached");
+      }
+   }
+   if (sysmem)
