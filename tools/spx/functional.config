# Bluetooth profiles and userspace HID transport; pairing is still untested.
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_UHID=m

# Daily-use CPU frequency scaling; idle-power acceptance still needs measurement.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=n
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
