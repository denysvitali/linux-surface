# SPDX-License-Identifier: GPL-2.0-only
# Bluetooth profiles and userspace HID transport; pairing is still untested.
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_UHID=m

# IPv6 MARK/CONNMARK targets for iptables-nft; routing validation is pending.
CONFIG_IP6_NF_IPTABLES=m

# Daily-use CPU frequency scaling; idle-power acceptance still needs measurement.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=n
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Deferred USC-to-DP0 startup; pre-connected docks and replug remain unverified.
CONFIG_SURFACE_AGGREGATOR_USBC=m

# Correct fitted color sensor; cover/uncover and auto-brightness remain untested.
CONFIG_TCS3430=m
