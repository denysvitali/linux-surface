From: Surface Pro X port
Subject: [PATCH] ipa: libipa: Add OV7251 gain-code conversion

The simple IPA fallback treats native register values as gain factors.
OV7251 writes its gain code directly; the existing Raspberry Pi helper
uses code / 16. Register that same conversion for the generic IPA.
Do not guess black level or change IR illumination.

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -791,6 +791,17 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov64a40", CameraSensorHelperOv64a40)
 
+class CameraSensorHelperOv7251 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv7251()
+	{
+		/* Match the OV7251 gain conversion in the Raspberry Pi helper. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 16 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov7251", CameraSensorHelperOv7251)
+
 class CameraSensorHelperOv8858 : public CameraSensorHelper
 {
 public:
