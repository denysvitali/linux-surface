 	void statsGBRG12PLine0(const uint8_t *src[], SwIspStats &stats);
diff --git a/src/libcamera/software_isp/debayer_cpu.cpp b/src/libcamera/software_isp/debayer_cpu.cpp
index 49382b4..d79ebe2 100644
--- a/src/libcamera/software_isp/debayer_cpu.cpp
+++ b/src/libcamera/software_isp/debayer_cpu.cpp
@@ -423,10 +423,26 @@ void DebayerCpu::debayer12P_RGRG_BGR888(uint8_t *dst, const uint8_t *src[])
 	}
 }
 
+template<bool addAlphaByte>
+void DebayerCpu::mono10P_RGB888(uint8_t *dst, const uint8_t *src[])
+{
+	const uint8_t *line = src[1];
+	for (unsigned int x = 0; x < window_.width; x += 4, line += 5) {
+		for (unsigned int p = 0; p < 4; p++) {
+			unsigned int raw = (line[p] << 2) | ((line[4] >> (2 * p)) & 3);
+			uint8_t value = mono_[raw];
+			*dst++ = value;
+			*dst++ = value;
+			*dst++ = value;
+			if constexpr (addAlphaByte)
+				*dst++ = 255;
+		}
+	}
+}
+
 /*
  * Setup the Debayer object according to the passed in parameters.
- * Return 0 on success, a negative errno value on failure
- * (unsupported parameters).
+ * Return 0 on success, a negative errno value on failure.
  */
 int DebayerCpu::getInputConfig(PixelFormat inputFormat, DebayerInputConfig &config)
 {
@@ -451,7 +467,7 @@ int DebayerCpu::getInputConfig(PixelFormat inputFormat, DebayerInputConfig &conf
 
 	if (bayerFormat.bitDepth == 10 &&
 	    bayerFormat.packing == BayerFormat::Packing::CSI2 &&
-	    isStandardBayerOrder(bayerFormat.order)) {
+	    (isStandardBayerOrder(bayerFormat.order) || bayerFormat.order == BayerFormat::MONO)) {
 		config.bpp = 10;
 		config.patternSize.width = 4; /* 5 bytes per *4* pixels */
 		config.patternSize.height = 2;
@@ -570,6 +586,9 @@ int DebayerCpu::setDebayerFunctions(PixelFormat inputFormat,
 		case BayerFormat::RGGB:
 			bayerFormat.order = BayerFormat::BGGR;
 			break;
+		case BayerFormat::MONO:
+			swapRedBlueGains_ = false;
+			break;
 		default:
 			return invalidFmt();
 		}
@@ -578,6 +597,16 @@ int DebayerCpu::setDebayerFunctions(PixelFormat inputFormat,
 		return invalidFmt();
 	}
 
+	if (bayerFormat.order == BayerFormat::MONO && bayerFormat.bitDepth == 10 &&
+	    bayerFormat.packing == BayerFormat::Packing::CSI2) {
+		if (ccmEnabled)
+			return invalidFmt();
+		debayer0_ = addAlphaByte ? &DebayerCpu::mono10P_RGB888<true>
+					: &DebayerCpu::mono10P_RGB888<false>;
+		debayer1_ = debayer0_;
+		return 0;
+	}
+
 	if ((bayerFormat.bitDepth == 8 || bayerFormat.bitDepth == 10 || bayerFormat.bitDepth == 12) &&
 	    bayerFormat.packing == BayerFormat::Packing::None &&
 	    isStandardBayerOrder(bayerFormat.order)) {
@@ -694,7 +723,7 @@ int DebayerCpu::configure(const StreamConfiguration &inputCfg,
 	 * own parameters. Let's enforce recomputing lookup tables by setting the
 	 * stored last used gamma to an out-of-range value.
 	 */
-	params_.gamma = 1.0;
+	params_.gamma = inputCfg.pixelFormat == formats::R10_CSI2P ? 0.0 : 1.0;
 
 	window_.x = ((inputCfg.size.width - outputCfg.size.width) / 2) &
 		    ~(inputConfig_.patternSize.width - 1);
@@ -1052,6 +1081,13 @@ void DebayerCpu::updateLookupTables(const DebayerParams &params)
 				green[i] = gammaTable_[lutGains.g()];
 				blue[i] = gammaTable_[lutGains.b()];
 			}
+			/* A monochrome pixel has one intensity, with all ten bits retained. */
+			for (unsigned int i = 0; i < mono_.size(); i++) {
+				float index = gains.g() * (i / 4.0f - blackIndex.g()) *
+					      gammaTableSize / div.g();
+				index = std::clamp(index, 0.0f, gammaTableSize - 1.0f);
+				mono_[i] = gammaTable_[index];
+			}
 		}
 	}
 
diff --git a/src/libcamera/software_isp/debayer_cpu.h b/src/libcamera/software_isp/debayer_cpu.h
