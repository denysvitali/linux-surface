diff --git a/src/libcamera/software_isp/swstats_cpu.cpp b/src/libcamera/software_isp/swstats_cpu.cpp
index 7fb77ce..c5cc187 100644
--- a/src/libcamera/software_isp/swstats_cpu.cpp
+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -271,6 +271,17 @@ void SwStatsCpu::statsBGGR12Line0(const uint8_t *src[], SwIspStats &stats)
 	SWSTATS_FINISH_LINE_STATS()
 }
 
+void SwStatsCpu::statsMono10PLine0(const uint8_t *src[], SwIspStats &stats)
+{
+	const uint8_t *line = src[1] + window_.x * 5 / 4;
+	/* Match the Bayer statistics density, with one scalar sample per group. */
+	for (unsigned int x = 0; x < window_.width * 5 / 4; x += 5) {
+		uint8_t value = line[x];
+		stats.sum_ += RGB<uint64_t>(value);
+		stats.yHistogram[value * SwIspStats::kYHistogramSize / 256]++;
+	}
+}
+
 void SwStatsCpu::statsBGGR10PLine0(const uint8_t *src[], SwIspStats &stats)
 {
 	const uint8_t *src0 = src[1] + window_.x * 5 / 4;
@@ -520,6 +531,13 @@ int SwStatsCpu::configure(const StreamConfiguration &inputCfg, unsigned int stat
 			stats0_ = (bitDepth == 10) ? &SwStatsCpu::statsGBRG10PLine0 : &SwStatsCpu::statsGBRG12PLine0;
 			swapLines_ = bayerFormat.order == BayerFormat::RGGB;
 			return 0;
+		case BayerFormat::MONO:
+			if (bitDepth == 10) {
+				stats0_ = &SwStatsCpu::statsMono10PLine0;
+				swapLines_ = false;
+				return 0;
+			}
+			break;
 		default:
 			break;
 		}
