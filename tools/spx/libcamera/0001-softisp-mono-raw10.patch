@@ -86,6 +86,10 @@ private:
 	void debayer2(uint8_t *dst, const uint8_t *src[]) { (this->*debayer2_)(dst, src); }
 	void debayer3(uint8_t *dst, const uint8_t *src[]) { (this->*debayer3_)(dst, src); }
 
+	/* CSI-2 packed 10-bit monochrome format */
+	template<bool addAlphaByte>
+	void mono10P_RGB888(uint8_t *dst, const uint8_t *src[]);
+
 	/* 8-bit raw bayer format */
 	template<bool addAlphaByte, bool ccmEnabled>
 	void debayer8_BGBG_BGR888(uint8_t *dst, const uint8_t *src[]);
@@ -141,6 +145,7 @@ private:
 	LookupTable red_;
 	LookupTable green_;
 	LookupTable blue_;
+	std::array<uint8_t, 1024> mono_;
 	CcmLookupTable redCcm_;
 	CcmLookupTable greenCcm_;
 	CcmLookupTable blueCcm_;
