diff --git a/test/mono10p.cpp b/test/mono10p.cpp
new file mode 100644
index 0000000..ef37805
--- /dev/null
+++ b/test/mono10p.cpp
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <libcamera/camera_manager.h>
+#include <libcamera/formats.h>
+#include <libcamera/stream.h>
+
+#include "libcamera/internal/framebuffer.h"
+#include "libcamera/internal/mapped_framebuffer.h"
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+#include "../src/libcamera/software_isp/debayer_cpu.h"
+#include "test.h"
+
+using namespace libcamera;
+
+class Mono10PTest : public Test
+{
+	std::unique_ptr<FrameBuffer> buffer(unsigned int size)
+	{
+		SharedFD fd(memfd_create("mono10p-fixture", MFD_CLOEXEC));
+		if (!fd.isValid() || ftruncate(fd.get(), size))
+			return nullptr;
+		std::vector<FrameBuffer::Plane> planes = { { fd, 0, size } };
+		auto result = std::make_unique<FrameBuffer>(planes);
+		result->_d()->metadata().status = FrameMetadata::FrameSuccess;
+		return result;
+	}
+
+	int run() override
+	{
+		CameraManager cm;
+		StreamConfiguration input;
+		input.pixelFormat = formats::R10_CSI2P;
+		input.size = { 16, 8 };
+		input.stride = 32; /* Include poisoned row padding. */
+		auto src = buffer(input.stride * input.size.height);
+		if (!src)
+			return TestFail;
+		MappedFrameBuffer source(src.get(), MappedFrameBuffer::MapFlag::ReadWrite);
+		if (!source.isValid())
+			return TestFail;
+		std::fill(source.planes()[0].begin(), source.planes()[0].end(), 0xa5);
+		unsigned int samples[8][16];
+		for (unsigned int y = 0; y < 8; y++) {
+			uint8_t *line = source.planes()[0].data() + y * input.stride;
+			for (unsigned int x = 0; x < 16; x += 4) {
+				line[4] = 0;
+				for (unsigned int p = 0; p < 4; p++) {
+					unsigned int value = (61 * (x + p) + 137 * y) & 1023;
+					if (y == 0 && x == 4)
+						value = p; /* Same MSB, different two-bit tails. */
+					samples[y][x + p] = value;
+					line[p] = value >> 2;
+					line[4] |= (value & 3) << (2 * p);
+				}
+				line += 5;
+			}
+		}
+
+		for (float gamma : { 1.0f, 0.5f }) {
+			for (PixelFormat format : { formats::RGB888, formats::BGR888, formats::XRGB8888 }) {
+				DebayerCpu cpu(std::make_unique<SwStatsCpu>(cm), cm);
+				StreamConfiguration output;
+				output.pixelFormat = format;
+				output.size = { 8, 8 }; /* Crop begins at source column four. */
+				std::tie(output.stride, output.frameSize) = cpu.strideAndFrameSize(format, output.size);
+				std::vector<std::reference_wrapper<const StreamConfiguration>> outputs = { output };
+				if (cpu.configure(input, outputs, false))
+					return TestFail;
+				auto dst = buffer(output.frameSize);
+				if (!dst)
+					return TestFail;
+				DebayerParams params;
+				params.gamma = gamma;
+				cpu.start();
+				cpu.process(0, src.get(), dst.get(), params);
+				cpu.stop();
+				MappedFrameBuffer result(dst.get(), MappedFrameBuffer::MapFlag::Read);
+				if (!result.isValid())
+					return TestFail;
+				unsigned int bytes = format == formats::XRGB8888 ? 4 : 3;
+				for (unsigned int y = 0; y < 8; y++) {
+					const uint8_t *line = result.planes()[0].data() + y * output.stride;
+					for (unsigned int x = 0; x < 8; x++) {
+						int expected = 255 * std::pow(samples[y][x + 4] / 1023.0, gamma);
+						const uint8_t *pixel = line + x * bytes;
+						if (std::abs(pixel[0] - expected) > 1 ||
+						    pixel[0] != pixel[1] || pixel[1] != pixel[2] ||
+						    (bytes == 4 && pixel[3] != 255)) {
+							std::cerr << "Mono packing, row stride or channel mismatch at "
+								  << x << "," << y << std::endl;
+							return TestFail;
+						}
+					}
+				}
+				SwIspStats stats;
+				if (pread(cpu.getStatsFD().get(), &stats, sizeof(stats), 0) != sizeof(stats) ||
+				    !stats.valid || stats.sum_.r() != stats.sum_.g() ||
+				    stats.sum_.g() != stats.sum_.b() || !stats.sum_.g())
+					return TestFail;
+			}
+		}
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(Mono10PTest)
