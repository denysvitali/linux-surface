 src/libcamera/software_isp/debayer_cpu.cpp    |  44 ++++++-
 src/libcamera/software_isp/debayer_cpu.h      |   5 +
 src/libcamera/software_isp/software_isp.cpp   |   5 +-
 src/libcamera/software_isp/swstats_cpu.cpp    |  18 +++
 test/meson.build                              |   4 +
 test/mono10p.cpp                              | 112 ++++++++++++++++++
 7 files changed, 184 insertions(+), 5 deletions(-)
 create mode 100644 test/mono10p.cpp

diff --git a/include/libcamera/internal/software_isp/swstats_cpu.h b/include/libcamera/internal/software_isp/swstats_cpu.h
index 5518709..574bb69 100644
--- a/include/libcamera/internal/software_isp/swstats_cpu.h
+++ b/include/libcamera/internal/software_isp/swstats_cpu.h
@@ -98,6 +98,7 @@ private:
 	/* Bayer 10 bpp packed */
 	void statsBGGR10PLine0(const uint8_t *src[], SwIspStats &stats);
 	void statsGBRG10PLine0(const uint8_t *src[], SwIspStats &stats);
+	void statsMono10PLine0(const uint8_t *src[], SwIspStats &stats);
 	/* Bayer 12 bpp packed */
