# libcamera 0.7.2 + the Surface Pro X software-ISP patches, in a private prefix.
# Installs beside, not over, the distro libcamera: nothing links against it unless
# a service opts in (see spx-libcamera-wireplumber.conf).
pkgname=spx-libcamera
pkgver=0.7.2
pkgrel=1
pkgdesc='libcamera 0.7.2 with Surface Pro X software-ISP patches (private prefix /usr/lib/spx-libcamera)'
arch=('aarch64')
url='https://libcamera.org'
license=('LGPL-2.1-or-later' 'GPL-2.0-or-later')
depends=('gnutls' 'libyaml' 'libglvnd' 'libunwind' 'libelf' 'libevent' 'systemd-libs')
makedepends=('git' 'meson' 'ninja' 'pkgconf' 'openssl' 'python-yaml' 'python-ply' 'python-jinja')
options=('!debug' '!lto')
_commit=191e202178f02430b5942397c70d215cdd2056fa   # upstream tag v0.7.2
source=("libcamera::git+https://git.libcamera.org/libcamera/libcamera.git#commit=${_commit}"
        '0001-softisp-mono-raw10.patch'
        '0002-ov5693-gain-units.patch'
        '0003-softisp-exposure-compensation.patch'
        '0004-ov7251-gain-units.patch'
        'ov5693-daylight.yaml')
sha256sums=('SKIP'
            '58caf15104c36e74373111ec25e70cb0100940b51033b10213a6b0c0e7838ca8'
            '1e300e1d9bdb2a37452a352359bd13815060655d7fccf352627b031eac4c5d2c'
            '00d941d13ea8dab67c7b84d6a7b4bb1d21aa781966bf5cebe3c893ec93fd04d3'
            '1f357ff328b2e60d07cc8a9920559b92783cc64ed143fb7ca6b49bfae3d6f14f'
            '9318cb4c1f7f42ec1f251ebc9317aebacf6e010460f1f3d4fdc4999b8681149d')
_prefix=/usr/lib/spx-libcamera

prepare() {
  cd "${srcdir}/libcamera"
  # Order matters: 0002/0003 build on the monochrome patch's softisp changes.
  for p in 0001-softisp-mono-raw10 0002-ov5693-gain-units \
           0003-softisp-exposure-compensation 0004-ov7251-gain-units; do
    git apply "${srcdir}/${p}.patch"
  done
}

build() {
  # The validated private build used only the simple pipeline/IPA (the SC8180X
  # CAMSS path). -Dwerror=false: newer GCC than the validation build.
  meson setup "${srcdir}/build" "${srcdir}/libcamera" \
    --prefix="${_prefix}" --libdir=lib --libexecdir=libexec --datadir=share \
    --bindir=bin --sbindir=bin --sysconfdir=/etc \
    --buildtype=release -Dwerror=false \
    -Dpipelines=simple -Dipas=simple -Dsoftisp-gpu=enabled \
    -Dcam=enabled -Dtest=false -Dlc-compliance=disabled -Dqcam=disabled \
    -Dgstreamer=disabled -Dv4l2=disabled -Dpycamera=disabled \
    -Ddocumentation=disabled -Dtracing=disabled
  meson compile -C "${srcdir}/build"
}

package() {
  DESTDIR="${pkgdir}" meson install -C "${srcdir}/build" --no-rebuild
  # Explicit opt-in only: the single validated daylight CCM for the front sensor.
  # Select with LIBCAMERA_IPA_CONFIG_PATH=${_prefix}/share/spx-libcamera/tuning/daylight
  install -Dm644 "${srcdir}/ov5693-daylight.yaml" \
    "${pkgdir}${_prefix}/share/spx-libcamera/tuning/daylight/simple/ov5693.yaml"
}
