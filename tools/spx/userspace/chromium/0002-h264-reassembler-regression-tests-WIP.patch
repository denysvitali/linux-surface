+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/v4l2/h264_frame_reassembler.h"
+
+#include <initializer_list>
+#include <memory>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace media {
+namespace {
+
+// Three black 32x32 baseline pictures, two slices per picture, encoded with
+// libx264: slices=2:keyint=30:bframes=0:scenecut=0. Keep actual slice bytes so
+// these tests exercise H264Parser, not a synthetic frame-boundary model.
+constexpr uint8_t kSPS[] = {0x00, 0x00, 0x00, 0x01, 0x67, 0x42, 0xc0,
+                            0x0a, 0xd9, 0x09, 0x6c, 0x04, 0x40, 0x00,
+                            0x00, 0x03, 0x00, 0x40, 0x00, 0x00, 0x03,
+                            0x00, 0x83, 0xc4, 0x89, 0x92};
+constexpr uint8_t kPPS[] = {0x00, 0x00, 0x00, 0x01, 0x68,
+                            0xcb, 0x83, 0xcb, 0x20};
+constexpr uint8_t kIDR1[] = {0x00, 0x00, 0x01, 0x65, 0x88, 0x84,
+                             0x05, 0xff, 0xff, 0xff, 0x0f, 0x45,
+                             0x00, 0x01, 0x57, 0x9f, 0x27, 0x80};
+constexpr uint8_t kIDR2[] = {0x00, 0x00, 0x01, 0x65, 0x62, 0x21,
+                             0x01, 0x7f, 0xff, 0xff, 0xc3, 0xd1,
+                             0x40, 0x00, 0x55, 0xe7, 0xc9, 0xe0};
+constexpr uint8_t kP1Slice1[] = {0x00, 0x00, 0x00, 0x01, 0x41,
+                                 0x9a, 0x38, 0x0b, 0x7b, 0x80};
+constexpr uint8_t kP1Slice2[] = {0x00, 0x00, 0x01, 0x41, 0x66,
+                                 0x8e, 0x02, 0xde, 0xe0};
+constexpr uint8_t kP2Slice1[] = {0x00, 0x00, 0x00, 0x01, 0x41,
+                                 0x9a, 0x54, 0x02, 0xbe, 0xe0};
+constexpr uint8_t kP2Slice2[] = {0x00, 0x00, 0x01, 0x41, 0x66,
+                                 0x95, 0x00, 0xaf, 0xb8};
+
+constexpr uint8_t kSEI[] = {0x00, 0x00, 0x01, 0x06, 0x06, 0x01, 0x7c, 0x80};
+constexpr uint8_t kAUD[] = {0x00, 0x00, 0x01, 0x09, 0x10};
+constexpr uint8_t kEOSeq[] = {0x00, 0x00, 0x01, 0x0a, 0x80};
+constexpr uint8_t kEOStream[] = {0x00, 0x00, 0x01, 0x0b, 0x80};
+constexpr uint8_t kFiller[] = {0x00, 0x00, 0x01, 0x0c, 0xff, 0x80};
+
+std::vector<uint8_t> Join(
+    std::initializer_list<base::span<const uint8_t>> nalus) {
+  std::vector<uint8_t> bytes;
+  for (const auto nalu : nalus) {
+    bytes.insert(bytes.end(), nalu.begin(), nalu.end());
+  }
+  return bytes;
+}
+
+class H264FrameReassemblerTest : public testing::Test {
+ protected:
+  void Feed(base::span<const uint8_t> bytes, int timestamp) {
+    auto buffer = DecoderBuffer::CopyFrom(bytes);
+    buffer->set_timestamp(base::Milliseconds(timestamp));
+    const int callback_id = submitted_++;
+    auto frames = reassembler_->Process(
+        std::move(buffer),
+        base::BindOnce(
+            [](std::vector<int>* callbacks, int id, DecoderStatus status) {
+              EXPECT_TRUE(status.is_ok());
+              callbacks->push_back(id);
+            },
+            &callbacks_, callback_id));
+    for (auto& [frame, callback] : frames) {
+      if (frame) {
+        frames_.push_back(std::move(frame));
+      }
+      // As the OUTPUT queue would, accept callbacks in the returned order.
+      std::move(callback).Run(DecoderStatus::Codes::kOk);
+    }
+  }
+
+  void Drain() {
+    ASSERT_TRUE(reassembler_->HasFragments());
+    frames_.push_back(reassembler_->AssembleAndFlushFragments());
+    EXPECT_FALSE(reassembler_->HasFragments());
+  }
+
+  void ExpectFrame(size_t index,
+                   base::span<const uint8_t> bytes,
+                   int timestamp) {
+    ASSERT_LT(index, frames_.size());
+    EXPECT_EQ(base::span(*frames_[index]), bytes);
+    EXPECT_EQ(frames_[index]->timestamp(), base::Milliseconds(timestamp));
+  }
+
+  std::unique_ptr<H264FrameReassembler> reassembler_ =
+      std::make_unique<H264FrameReassembler>();
+  std::vector<scoped_refptr<DecoderBuffer>> frames_;
+  std::vector<int> callbacks_;
+  int submitted_ = 0;
+};
+
+TEST_F(H264FrameReassemblerTest, PrefixesStayWithNextPicture) {
+  Feed(kAUD, 1);
+  Feed(kSPS, 2);
+  Feed(kPPS, 3);
+  Feed(kSEI, 4);
+  EXPECT_TRUE(frames_.empty());
+  Feed(kIDR1, 10);
+  Feed(kIDR2, 11);
+  EXPECT_TRUE(frames_.empty());
+  Feed(kP1Slice1, 20);
+  ASSERT_EQ(frames_.size(), 1u);
+  ExpectFrame(0, Join({kAUD, kSPS, kPPS, kSEI, kIDR1, kIDR2}), 11);
+  EXPECT_EQ(callbacks_, (std::vector<int>{0, 1, 2, 3, 4, 5, 6}));
+}
+
+TEST_F(H264FrameReassemblerTest, MultiplePicturesAndSlicesInOneBuffer) {
+  const auto first = Join({kSPS, kPPS, kSEI, kIDR1, kIDR2});
+  const auto second = Join({kP1Slice1, kP1Slice2});
+  const auto third = Join({kP2Slice1, kP2Slice2});
+  Feed(Join({first, second, third}), 12);
+  ASSERT_EQ(frames_.size(), 2u);
+  ExpectFrame(0, first, 12);
+  ExpectFrame(1, second, 12);
+  EXPECT_EQ(callbacks_, (std::vector<int>{0}));
+  Drain();
+  ASSERT_EQ(frames_.size(), 3u);
+  ExpectFrame(2, third, 12);
+}
+
+TEST_F(H264FrameReassemblerTest, PrefixAfterPictureStartsNextAccessUnit) {
+  const auto first = Join({kSPS, kPPS, kIDR1, kIDR2});
+  Feed(first, 1);
+  Feed(kAUD, 2);
+  ASSERT_EQ(frames_.size(), 1u);
+  ExpectFrame(0, first, 1);
+  Feed(kSPS, 3);
+  Feed(kPPS, 4);
+  Feed(kSEI, 5);
+  EXPECT_EQ(frames_.size(), 1u);
+  Feed(Join({kP1Slice1, kP1Slice2}), 6);
+  Drain();
+  ASSERT_EQ(frames_.size(), 2u);
+  ExpectFrame(1, Join({kAUD, kSPS, kPPS, kSEI, kP1Slice1, kP1Slice2}), 6);
+}
+
+TEST_F(H264FrameReassemblerTest, EndMarkersAndFillerStayWithPicture) {
+  const auto first = Join({kSPS, kPPS, kIDR1, kIDR2});
+  Feed(first, 1);
+  Feed(kFiller, 2);
+  Feed(kEOSeq, 3);
+  EXPECT_TRUE(frames_.empty());
+  Feed(kEOStream, 4);
+  ASSERT_EQ(frames_.size(), 1u);
+  ExpectFrame(0, Join({first, kFiller, kEOSeq, kEOStream}), 4);
+  EXPECT_FALSE(reassembler_->HasFragments());
+  EXPECT_EQ(callbacks_, (std::vector<int>{0, 1, 2, 3}));
+}
+
+TEST_F(H264FrameReassemblerTest, EndOfSequenceForcesPictureBoundary) {
+  const auto picture = Join({kSPS, kPPS, kIDR1, kIDR2});
+  Feed(picture, 1);
+  Feed(kEOSeq, 2);
+  // Repeat the same picture bytes: an explicit end-of-sequence must prevent
+  // its first slice from being appended to the preceding picture.
+  Feed(kIDR2, 3);
+  ASSERT_EQ(frames_.size(), 1u);
+  ExpectFrame(0, Join({picture, kEOSeq}), 2);
+  Drain();
+  ExpectFrame(1, kIDR2, 3);
+}
+
+TEST_F(H264FrameReassemblerTest, DrainClearsLookaheadForReuse) {
+  const auto picture = Join({kSPS, kPPS, kIDR1, kIDR2});
+  Feed(picture, 1);
+  Drain();
+  ExpectFrame(0, picture, 1);
+  Feed(kIDR2, 2);
+  EXPECT_EQ(frames_.size(), 1u);
+  Drain();
+  ASSERT_EQ(frames_.size(), 2u);
+  ExpectFrame(1, kIDR2, 2);
+  EXPECT_EQ(callbacks_, (std::vector<int>{0, 1}));
+}
+
+TEST_F(H264FrameReassemblerTest, ResetDropsPendingBytes) {
+  Feed(Join({kSPS, kPPS, kIDR1}), 1);
+  EXPECT_TRUE(reassembler_->HasFragments());
+  // V4L2StatefulVideoDecoder::Reset recreates the reassembler.
+  reassembler_ = std::make_unique<H264FrameReassembler>();
+  EXPECT_FALSE(reassembler_->HasFragments());
+  const auto picture = Join({kSPS, kPPS, kIDR1, kIDR2});
+  Feed(picture, 2);
+  Drain();
+  ASSERT_EQ(frames_.size(), 1u);
+  ExpectFrame(0, picture, 2);
+  EXPECT_EQ(callbacks_, (std::vector<int>{0, 1}));
+}
+
+TEST_F(H264FrameReassemblerTest, InvalidSliceAndMissingNaluFail) {
+  constexpr uint8_t kInvalidSlice[] = {0x00, 0x00, 0x01, 0x65};
+  constexpr uint8_t kMissingNalu[] = {0x00, 0x00, 0x00};
+  for (const auto bytes : {base::span<const uint8_t>(kInvalidSlice),
+                           base::span<const uint8_t>(kMissingNalu)}) {
+    bool called = false;
+    auto frames = reassembler_->Process(
+        DecoderBuffer::CopyFrom(bytes),
+        base::BindOnce(
+            [](bool* called, DecoderStatus status) {
+              *called = true;
+              EXPECT_EQ(status.code(), DecoderStatus::Codes::kFailed);
+            },
+            &called));
+    EXPECT_TRUE(called);
+    EXPECT_TRUE(frames.empty());
+  }
+}
+
+}  // namespace
+}  // namespace media
