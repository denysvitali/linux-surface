# Surface Pro X (SC8180X / SQ2) kernel config fragment
#
# This fragment is merged on top of the generic arm64 defconfig to produce
# a kernel tailored for the Microsoft Surface Pro X.  Apply with:
#
#   make ARCH=arm64 defconfig surface_pro_x.config
#
# or via scripts/kconfig/merge_config.sh:
#
#   ./scripts/kconfig/merge_config.sh \
#       arch/arm64/configs/defconfig \
#       arch/arm64/configs/surface_pro_x.config

# -----------------------------------------------------------------------
# Storage: PCIe NVMe for SC8180X Surface Pro X
#
# The Surface Pro X SQ2 uses a PCIe NVMe SSD (via pcie2) as its primary
# storage device. The SC8180X SoC has a UFS controller but no UFS device
# is wired to it on this board; the UFS nodes are disabled in the DTS.
# -----------------------------------------------------------------------

# dm-crypt is required for LUKS encrypted storage
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=m

# NLS (Native Language Support) for FAT filesystems (ESP partition)
CONFIG_NLS=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"

# -----------------------------------------------------------------------
# Display / GPU: Adreno 680 (SC8180X)
# -----------------------------------------------------------------------

# MSM DRM driver covering all Adreno and Display subsystems
CONFIG_DRM_MSM=m

# DRM display helpers needed for DP Alt Mode output
CONFIG_DRM_DISPLAY_HELPER=m
CONFIG_DRM_DISPLAY_DP_HELPER=y

# -----------------------------------------------------------------------
# USB / USB-C / DisplayPort Alt Mode
# -----------------------------------------------------------------------

# DWC3 USB controller (SC8180X has two DWC3 instances)
# Built-in so USB is available during early boot before modules load
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y

# QMP combo PHY (USB3 + DP Alt Mode on the same PHY lane)
CONFIG_PHY_QCOM_QMP_COMBO=y

# QMP USB PHY (secondary USB controller)
CONFIG_PHY_QCOM_QMP_USB=y

# SNPS femto v2 USB PHY (required for DWC3 USB in initramfs)
# Built-in so USB works during early boot
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# USB Attached SCSI (built-in so it's available in initramfs without module loading)
CONFIG_USB_UAS=y

# UCSI (USB Type-C Connector System Software Interface)
CONFIG_TYPEC_UCSI=m

# ACPI-based UCSI transport (Surface Pro X exposes UCSI via ACPI)
CONFIG_UCSI_ACPI=m

# DP Alt Mode over Type-C (external display via USB-C)
CONFIG_TYPEC_DP_ALTMODE=m

# PMIC GLINK UCSI transport (alternative UCSI path via PMIC firmware)
CONFIG_UCSI_PMIC_GLINK=m

# -----------------------------------------------------------------------
# Input / HID
# -----------------------------------------------------------------------

# Microsoft SPI-HID transport (Type Cover keyboard, touchscreen, pen on SPX)
# Built-in so the keyboard works without initramfs module loading.
# The SPI controller (GENI) must also be built-in for the same reason.
CONFIG_SPI_QCOM_GENI=y
CONFIG_SPI_HID=y

# I2C-HID over ACPI (keyboard cover / Type Cover)
CONFIG_I2C_HID_ACPI=m

# Surface System Aggregator Module (SAM / SSAM) subsystem core
# Manages battery, thermal, HID input on 5th-gen+ Surface devices
# Built-in so the Type Cover keyboard works without initramfs modules
CONFIG_SURFACE_AGGREGATOR=y
CONFIG_SURFACE_AGGREGATOR_BUS=y

# SSAM device registry -- instantiates non-ACPI SSAM client devices
CONFIG_SURFACE_AGGREGATOR_REGISTRY=y

# SSAM subsystem device hubs (KIP hub manages Type Cover on SPX)
CONFIG_SURFACE_AGGREGATOR_HUB=y

# SSAM debug/control interface (useful for development and diagnostics)
CONFIG_SURFACE_AGGREGATOR_CDEV=m

# SSAM tablet mode switch (lid angle / posture detection)
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=m

# SSAM platform profile (performance / balanced / power-saver modes)
CONFIG_SURFACE_PLATFORM_PROFILE=m

# SSAM HID transport driver (keyboard, touchpad via SAM on SPX)
CONFIG_SURFACE_HID=y

# GPIO-based hardware buttons (volume up/down, power on tablet form factor)
CONFIG_KEYBOARD_GPIO=y

# SoC button array (power/volume/rotation lock as input events)
CONFIG_INPUT_SOC_BUTTON_ARRAY=m

# -----------------------------------------------------------------------
# Power supply: Surface battery and charger via SAM
# -----------------------------------------------------------------------

CONFIG_POWER_SUPPLY=y

# Surface battery driver (reads capacity/voltage/cycle count via SAM)
CONFIG_BATTERY_SURFACE=m

# Surface charger driver (monitors AC adapter state via SAM)
CONFIG_CHARGER_SURFACE=m

# ACPI power meter (Surface Pro X ACPI000D device)
CONFIG_SENSORS_ACPI_POWER=m

# -----------------------------------------------------------------------
# Wireless: WCN3990/WCN3998 class WLAN + BT on the SC8180X SNOC/UART path
# -----------------------------------------------------------------------

# RFKILL and wireless core - built-in for early boot availability
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# The Surface Pro X DTS brings up Wi-Fi via the on-SoC SNOC-connected wlan
# block together with remoteproc_mpss firmware (qcmpss8180.mbn). Keep ath10k
# built in so the expected board path is available without module loading.
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_ATH10K_DEBUG=y
CONFIG_ATH10K_TRACING=y

# Keep ath11k available for experiments, but it is not the documented default
# bring-up path for the current SPX DTS/package flow.
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m

# CRDA (Central Regulatory Domain Agent) for loading regulatory.db at boot.
# Built-in so cfg80211 can load the wireless regulatory database immediately,
# without waiting for module insertion. The regulatory.db file must be
# provided by userspace (wireless-regdb package) at /lib/firmware/regulatory.db.
# Without this, the kernel logs "Direct firmware load for regulatory.db failed
# with error -2" and cfg80211 operates with no regulatory domain information.
CONFIG_CFG80211_CRDA_SUPPORT=y

# QCA Bluetooth UART transport (BT side of the WCN3998-class combo chip)
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y

# WCNSS control driver for NV download to WCNSS-based wireless chips.
# Built-in so the BT+WiFi subsystem is available early in boot. This driver
# provides the SMD channel used to download calibration/NV data to the WCNSS
# coprocessor on platforms that use the older Pronto/Riva WCNSS firmware path.
# On SC8180X SPX, the WCN3998 BT firmware is loaded directly via the UART
# firmware-name property, but having this driver available helps with any
# WCNSS-specific calibration data paths.
CONFIG_QCOM_WCNSS_CTRL=y

# -----------------------------------------------------------------------
# Audio: Qualcomm LPASS / SoundWire / WCD9380 codec
# (RE finding: SPX uses Qualcomm audio, NOT Intel HDA)
# -----------------------------------------------------------------------

# ALSA SoC core for Qualcomm platforms
CONFIG_SND_SOC_QCOM=m

# QDSP6 audio DSP driver (Hexagon 685 ADSP on SC8180X)
CONFIG_SND_SOC_QDSP6=m

# SM8250 audio machine driver (qcom,sm8250-sndcard compatible for SC8180X)
CONFIG_SND_SOC_SM8250=m

# WCD938x codec driver (WCD9380 on SPX, connected via SoundWire)
CONFIG_SND_SOC_WCD938X=m
CONFIG_SND_SOC_WCD938X_SDW=m

# WSA881x Class-D speaker amplifier (SoundWire-attached on SPX)
CONFIG_SND_SOC_WSA881X=m

# SoundWire bus (used for codec-to-SoC audio transport on SPX)
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m

# RPMSG GLINK (ADSP communication channel for audio firmware)
CONFIG_RPMSG_QCOM_GLINK=m

# -----------------------------------------------------------------------
# Sensors: AMS TCS3430 XYZ color / ambient-light sensor
# -----------------------------------------------------------------------

# IIO subsystem core
CONFIG_IIO=y

# AMS TCS3430 4-channel XYZ+IR color sensor (lid light sensor on SPX)
CONFIG_TCS3430=m

# -----------------------------------------------------------------------
# Camera: Qualcomm CAMSS sensors identified on SPX
# -----------------------------------------------------------------------

# CAMCC (Camera Clock Controller) — MUST be built-in (=y).  The camcc
# driver registers the CAMSS GDSC power domains (IFE_0–3, TITAN_TOP).
# Without it the power domains never exist, causing CAMSS to fail with
# "Failed to configure power domains: -517" on every probe attempt.
CONFIG_SC_CAMCC_8180X=y

# Qualcomm Camera Subsystem (Spectra 390 ISP on SC8180X)
# NOTE: also requires CONFIG_QCOM_IOMMU=y (provided by defconfig) and
# CAMCC clocks/resets registered via SC_CAMCC_8180X above.
CONFIG_VIDEO_QCOM_CAMSS=m

# Qualcomm Venus hardware video codec block
CONFIG_VIDEO_QCOM_VENUS=m

# Rear RGB, front RGB, and IR camera sensors documented from SPX ACPI
CONFIG_VIDEO_OV13858=m
CONFIG_VIDEO_OV5693=m
CONFIG_VIDEO_OV7251=m

# -----------------------------------------------------------------------
# Camera: INT3472 TPS68470 PMIC (camera power and clock control)
# -----------------------------------------------------------------------

# Intel SkyLake INT3472 camera power controller (needed for CAMSS sensors)
# Provides clock and regulator control for TPS68470 PMIC on Surface devices.
# This driver must be loaded before camera sensors (via _DEP in ACPI).
CONFIG_INTEL_SKL_INT3472=m

# TPS68470 MFD core (provides regmap and device registration)
CONFIG_MFD_TPS68470=m

# TPS68470 clock driver (provides camera sensor clocks)
CONFIG_TPS68470_CLOCK=m

# TPS68470 regulator driver (provides camera sensor power rails)
CONFIG_TPS68470_REGULATOR=m

# -----------------------------------------------------------------------
# Crypto: Qualcomm Crypto Engine
# -----------------------------------------------------------------------

# QCE inline crypto engine (hardware AES/SHA for storage encryption)
CONFIG_CRYPTO_DEV_QCE=m

# -----------------------------------------------------------------------
# Remoteproc: DSP firmware loading
# -----------------------------------------------------------------------

# PIL (Peripheral Image Loader) info for remoteproc crash dumps
CONFIG_QCOM_PIL_INFO=y

# -----------------------------------------------------------------------
# Modem / WWAN: IPA, QRTR, rmnet, and generic WWAN interfaces
# -----------------------------------------------------------------------

# Qualcomm IPC router used by modem and remoteproc services
CONFIG_QRTR=y
CONFIG_QRTR_SMD=m
CONFIG_QRTR_TUN=m
CONFIG_QRTR_MHI=m

# RMTFS memory driver for modem firmware loading
CONFIG_QCOM_RMTFS_MEM=y

# IP Accelerator and rmnet network path used by on-SoC WWAN
CONFIG_QCOM_IPA=m
CONFIG_RMNET=m

# Generic WWAN class support for userspace control stacks
CONFIG_WWAN=m

# -----------------------------------------------------------------------
# Thermal: Qualcomm thermal sensors
# -----------------------------------------------------------------------

# QCOM TSENS thermal sensor driver (already =y in defconfig; reinforce)
CONFIG_QCOM_TSENS=y

# -----------------------------------------------------------------------
# Interconnect: SC8180X Network-On-Chip bandwidth management
# -----------------------------------------------------------------------

# NoC / interconnect driver for SC8180X (already =y in defconfig; reinforce)
CONFIG_INTERCONNECT_QCOM_SC8180X=y

# -----------------------------------------------------------------------
# Overrides (from linux-surface/aarch64-packages overrides.config)
# -----------------------------------------------------------------------

# Disable debug info to reduce kernel image size
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set

# RCU stall detection: lower timeout (10s) to detect unclocked SoC parts
# faster, but raise expedited timeout (250ms) to avoid false positives
CONFIG_RCU_CPU_STALL_TIMEOUT=10
CONFIG_RCU_EXP_CPU_STALL_TIMEOUT=250

# Clear localversion (version string is set by the packaging)
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
