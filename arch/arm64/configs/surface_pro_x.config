# Surface Pro X (SC8180X / SQ2) kernel config fragment
#
# This fragment is merged on top of the generic arm64 defconfig to produce
# a kernel tailored for the Microsoft Surface Pro X.  Apply with:
#
#   make ARCH=arm64 defconfig surface_pro_x.config
#
# or via scripts/kconfig/merge_config.sh:
#
#   ./scripts/kconfig/merge_config.sh \
#       arch/arm64/configs/defconfig \
#       arch/arm64/configs/surface_pro_x.config

# -----------------------------------------------------------------------
# Storage: UFS (Universal Flash Storage) for SC8180X eMMC/UFS
# -----------------------------------------------------------------------

# Qualcomm-specific UFS host controller driver (required for SC8180X)
CONFIG_SCSI_UFS_QCOM=y

# UFS 3.1 Host Performance Booster -- caches L2P mappings in host DRAM
# improving random-read IOPS by 2-3x on supported devices
CONFIG_SCSI_UFS_HPB=y

# QMP UFS PHY needed alongside the QCOM UFS host controller
CONFIG_PHY_QCOM_QMP_UFS=y

# -----------------------------------------------------------------------
# Display / GPU: Adreno 680 (SC8180X)
# -----------------------------------------------------------------------

# MSM DRM driver covering all Adreno and Display subsystems
CONFIG_DRM_MSM=m

# -----------------------------------------------------------------------
# Input / HID
# -----------------------------------------------------------------------

# Microsoft SPI-HID transport (touchscreen, pen on Surface Pro X)
CONFIG_SPI_HID=m

# I2C-HID over ACPI (keyboard cover / Type Cover)
CONFIG_I2C_HID_ACPI=m

# Surface System Aggregator Module (SAM / SSAM) subsystem core
# Manages battery, thermal, HID input on 5th-gen+ Surface devices
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y

# SSAM device registry -- instantiates non-ACPI SSAM client devices
# (battery, AC, platform-profile, HID input on 7th-gen devices)
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m

# SSAM subsystem device hubs (KIP hub manages Type Cover on SPX)
CONFIG_SURFACE_AGGREGATOR_HUB=m

# SSAM HID transport driver (keyboard, touchpad via SAM on SPX)
CONFIG_SURFACE_HID=m

# GPIO-based hardware buttons (volume up/down, power on tablet form factor)
CONFIG_KEYBOARD_GPIO=y

# -----------------------------------------------------------------------
# Wireless: QCA6390 (Wi-Fi 6 + BT 5.1)
# -----------------------------------------------------------------------

# ath10k SNOC path covers the QCA6174/QCA6390 embedded WLAN subsystem
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m

# ath11k covers the QCA6390 Wi-Fi 6 radio (PCIe-attached variant)
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m

# QCA Bluetooth UART transport (BT side of QCA6390)
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y

# -----------------------------------------------------------------------
# Audio: QDSP6 / LPASS on SC8180X
# -----------------------------------------------------------------------

# ALSA SoC core for Qualcomm platforms
CONFIG_SND_SOC_QCOM=m

# QDSP6 audio DSP driver (used by SC8180X for all audio routing)
CONFIG_SND_SOC_QDSP6=m

# -----------------------------------------------------------------------
# Sensors: AMS TCS3430 XYZ color / ambient-light sensor
# -----------------------------------------------------------------------

# IIO subsystem core (pulled in as dep but make explicit)
CONFIG_IIO=y

# AMS TCS3430 4-channel XYZ+IR color sensor (lid light sensor on SPX)
CONFIG_TCS3430=m

# -----------------------------------------------------------------------
# USB-C / Thunderbolt
# -----------------------------------------------------------------------

# UCSI (USB Type-C Connector System Software Interface)
CONFIG_TYPEC_UCSI=m

# ACPI-based UCSI transport (Surface Pro X exposes UCSI via ACPI)
CONFIG_UCSI_ACPI=m

# -----------------------------------------------------------------------
# Crypto: Qualcomm Crypto Engine
# -----------------------------------------------------------------------

# QCE inline crypto engine (hardware AES/SHA for storage encryption)
CONFIG_CRYPTO_DEV_QCE=m

# -----------------------------------------------------------------------
# Thermal: Qualcomm thermal sensors
# -----------------------------------------------------------------------

# QCOM TSENS thermal sensor driver (already =y in defconfig; reinforce)
CONFIG_QCOM_TSENS=y

# -----------------------------------------------------------------------
# Interconnect: SC8180X Network-On-Chip bandwidth management
# -----------------------------------------------------------------------

# NoC / interconnect driver for SC8180X (already =y in defconfig; reinforce)
CONFIG_INTERCONNECT_QCOM_SC8180X=y
