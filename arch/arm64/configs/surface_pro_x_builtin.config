# Surface Pro X (SC8180X / SQ2) built-in override fragment
#
# Merge AFTER surface_pro_x.config to convert every =m driver to =y.
# This produces a kernel that boots without an initramfs: all SPX-specific
# drivers are statically linked into Image.gz, so a bare flash of
# Image.gz + DTB is sufficient for hardware testing.
#
# Apply with:
#   ./scripts/kconfig/merge_config.sh \
#       arch/arm64/configs/defconfig \
#       arch/arm64/configs/surface_pro_x.config \
#       arch/arm64/configs/surface_pro_x_builtin.config

# -----------------------------------------------------------------------
# Display / GPU: Adreno 680 (SC8180X)
# -----------------------------------------------------------------------
CONFIG_DRM_MSM=y
CONFIG_DRM_DISPLAY_HELPER=y

# -----------------------------------------------------------------------
# USB / USB-C / DisplayPort Alt Mode
# -----------------------------------------------------------------------
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_UCSI_PMIC_GLINK=y

# -----------------------------------------------------------------------
# Input / HID
# -----------------------------------------------------------------------
CONFIG_SPI_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_SURFACE_AGGREGATOR=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=y
CONFIG_SURFACE_AGGREGATOR_HUB=y
CONFIG_SURFACE_AGGREGATOR_CDEV=y
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=y
CONFIG_SURFACE_PLATFORM_PROFILE=y
CONFIG_SURFACE_HID=y
CONFIG_INPUT_SOC_BUTTON_ARRAY=y

# -----------------------------------------------------------------------
# Power supply: Surface battery and charger via SAM
# -----------------------------------------------------------------------
CONFIG_BATTERY_SURFACE=y
CONFIG_CHARGER_SURFACE=y
CONFIG_SENSORS_ACPI_POWER=y

# -----------------------------------------------------------------------
# Wireless: QCA6390 (Wi-Fi 6 + BT 5.1)
# -----------------------------------------------------------------------
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_BT_HCIUART=y

# -----------------------------------------------------------------------
# Audio: Qualcomm LPASS / SoundWire / WCD9380 codec
# -----------------------------------------------------------------------
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_SC8280XP=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SDW=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y
CONFIG_RPMSG_QCOM_GLINK=y

# -----------------------------------------------------------------------
# Sensors: AMS TCS3430 XYZ color / ambient-light sensor
# -----------------------------------------------------------------------
CONFIG_TCS3430=y

# -----------------------------------------------------------------------
# Crypto: Qualcomm Crypto Engine
# -----------------------------------------------------------------------
CONFIG_CRYPTO_DEV_QCE=y
