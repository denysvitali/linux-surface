post_install() {
    if [ -f /etc/mkinitcpio.d/linux-denys.preset ]; then
        mkinitcpio -p linux-denys
    else
        echo "WARNING: /etc/mkinitcpio.d/linux-denys.preset not found, skipping initramfs generation"
    fi
}

post_upgrade() {
    if [ -f /etc/mkinitcpio.d/linux-denys.preset ]; then
        mkinitcpio -p linux-denys
    else
        echo "WARNING: /etc/mkinitcpio.d/linux-denys.preset not found, skipping initramfs generation"
    fi
}
